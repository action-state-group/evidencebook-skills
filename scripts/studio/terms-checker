#!/usr/bin/env python3
"""A published deal terms pack as a capsulectl rules checker. One self-contained file:
capsulectl copies a pinned checker executable alone before running it.

    terms-checker COMPILED_JSON < external-check-input/v0 > external-check-result/v0

`terms publish` writes the pin file `capsulectl profile update --rules-checker`
reads, naming this checker and the pack's compiled.json. `deal check` runs it on
the seller's commit check (evidencebook-deal#137). One finding per pack row,
`id` = the row id, `check` = the row's check:

    price_as_offered   fail when the commit's amount_minor differs from the last
                       offer of the same deal in the history (action_id starts
                       with "<deal_id>/"), pass when equal, not_evaluable when
                       either is missing (said as pending on an offer, as decided at
                       the commit on any other step)
    other rows         not_applicable at commit time: they are decided after
                       payment and delivery, over the sale's closed record

Standard library only: the checker runs where the deal plugin runs.
"""
import json
import sys


def currency_of(body):
    """The currency a step's body states, directly or in its terms; None when it states none."""
    terms = body.get("terms")
    return body.get("currency") or (terms.get("currency") if isinstance(terms, dict) else None)


def money(minor, currency):
    """An amount the way the seller's card says it ($0.50), or None unless the step states USD:
    another unit (sats) would print a wrong number, and an unstated one cannot be assumed."""
    return f"${minor / 100:.2f}" if str(currency).upper() == "USD" else None


def commit_findings(doc, rows):
    record = doc.get("record") or {}
    body = (record.get("agent_input") or {}).get("body") or {}
    deal_id = record.get("deal_id") or str(record.get("action_id", "")).split("/")[0]
    commit = body.get("amount_minor") if body.get("action") == "commit" else None
    offer, offered = None, False
    for h in doc.get("history") or []:
        hb = (h.get("agent_input") or {}).get("body") or {}
        if str(h.get("action_id", "")).startswith(deal_id + "/"):
            if hb.get("action") == "offer":
                offer, offered = hb.get("amount_minor"), True
    findings = []
    for row in rows:
        f = {"id": row["id"], "check": row["check"]}
        name = str(row.get("statement") or row["id"]).strip().rstrip(".")
        if row["check"] != "price_as_offered":
            f["verdict"] = "not_applicable"
            f["reason"] = "decided after payment and delivery, over the closed sale"
        elif not all(isinstance(v, int) and not isinstance(v, bool) for v in (commit, offer)):
            # The seller's card says this reason as it stands (a pack check
            # states its rows in the user's own words, evidencebook-deal#157).
            f["verdict"] = "not_evaluable"
            if body.get("action") == "offer":
                f["reason"] = f'your rule "{name}" is checked at the commit'
            elif body.get("action") != "commit":
                # Some other step: the commit may be in the thread yet outside the history this
                # checker was given, so say only what is true either way. It still pauses.
                f["reason"] = f'your rule "{name}" is decided at the commit'
            elif not offered:
                f["reason"] = f'your rule "{name}" could not be checked: no offer of this deal on record'
            elif not isinstance(commit, int) or isinstance(commit, bool):
                f["reason"] = f'your rule "{name}" could not be checked: the commit states no amount'
            else:
                f["reason"] = f'your rule "{name}" could not be checked: the offer states no amount'
        else:
            f["verdict"] = "pass" if commit == offer else "fail"
            f["value"], f["limit"] = commit, offer
            if commit != offer:
                cur = currency_of(body)
                detail = (f"the commit was {money(commit, cur)}, the offer {money(offer, cur)}" if money(commit, cur)
                          else "the commit price is not the price offered")
                f["reason"] = f'your rule "{name}" did not hold ({detail})'
        findings.append(f)
    return findings


def main(argv):
    if len(argv) != 1:
        print("usage: terms-checker COMPILED_JSON < external-check-input/v0", file=sys.stderr)
        return 2
    pack = json.load(open(argv[0]))
    doc = json.load(sys.stdin)
    if doc.get("schema") != "external-check-input/v0":
        print("not an external-check-input/v0", file=sys.stderr)
        return 1
    findings = commit_findings(doc, pack["rows"])
    failed = any(f["verdict"] == "fail" for f in findings)
    if failed:
        for f in findings:
            if f["verdict"] == "fail":
                f["disposition"] = "ask"
    verdict = "deny" if failed else ("not_evaluable" if all(f["verdict"] in ("not_evaluable", "not_applicable") for f in findings) and any(f["verdict"] == "not_evaluable" for f in findings) else "allow")
    print(json.dumps({"schema": "external-check-result/v0", "ruleset_id": pack["contract_ref"].replace("@", "/"),
                      "definition_digest": pack["definition_digest"], "verdict": verdict, "tier": "recomputed",
                      "grade": "self-attested", "findings": findings}))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
